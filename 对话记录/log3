{
  "manifest_version": 3,
  "name": "AetherFlow",
  "version": "1.0.0",
  "description": "AI-powered prompt optimization and management",
  "permissions": ["sidePanel", "storage", "clipboardWrite", "tabs", "contextMenus", "scripting", "alarms"],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://app.anthropic.com/*",
    "https://chat.deepseek.com/*",
    "https://www.phind.com/*",
    "https://kimi.moonshot.cn/*",
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AetherFlow - AI Prompt Management"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}