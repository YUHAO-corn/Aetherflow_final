// 会员状态类型
const MembershipStatus = {
  FREE: 'free',
  PRO: 'pro',
  TRIAL: 'trial'
};

// 订阅计划类型
const SubscriptionPlan = {
  MONTHLY: 'monthly',
  ANNUAL: 'annual'
};

/**
 * 从事件数据中提取Firebase用户ID
 * 同时支持旧版API的passthrough和新版API的customData
 */
function extractFirebaseUserId(payload) {
  try {
    // 尝试从新版API的customData中获取
    if (payload.data && payload.data.custom_data) {
      // 如果customData是字符串，尝试解析为JSON
      const customData = typeof payload.data.custom_data === 'string' 
        ? JSON.parse(payload.data.custom_data) 
        : payload.data.custom_data;
      
      if (customData && customData.userId) {
        return customData.userId;
      }
    }
    
    // 直接从payload的customData中获取
    if (payload.custom_data) {
      const customData = typeof payload.custom_data === 'string' 
        ? JSON.parse(payload.custom_data) 
        : payload.custom_data;
      
      if (customData && customData.userId) {
        return customData.userId;
      }
    }
    
    // 尝试从旧版API的passthrough中获取
    if (payload.passthrough) {
      const passthrough = JSON.parse(payload.passthrough);
      if (passthrough && passthrough.userId) {
        return passthrough.userId;
      }
      // 兼容性：有些旧版可能直接存储了userId
      if (passthrough && passthrough.firebaseUserId) {
        return passthrough.firebaseUserId;
      }
    }
    
    // 如果找不到，返回null
    return null;
  } catch (error) {
    console.error('提取Firebase用户ID失败:', error);
    return null;
  }
}

/**
 * 创建或更新Paddle客户ID与Firebase用户ID的映射
 */
async function createUserIdMapping(paddleCustomerId, firebaseUserId) {
  try {
    const db = admin.firestore();
    
    // 构建数据对象并清理
    const mappingData = cleanFirestoreData({
      paddleCustomerId,
      firebaseUserId,
      updatedAt: admin.firestore.FieldValue.serverTimestamp()
    });
    
    // 在映射集合中创建文档
    await db.collection('customerMapping').doc(paddleCustomerId).set(mappingData, { merge: true });
    
    console.log(`已创建/更新用户ID映射: Paddle ID ${paddleCustomerId} -> Firebase ID ${firebaseUserId}`);
  } catch (error) {
    console.error(`创建/更新用户ID映射失败:`, error);
  }
}

/**
 * 查找与Paddle客户ID对应的Firebase用户ID
 */
async function findFirebaseUserIdByPaddleCustomerId(paddleCustomerId) {
  try {
    const db = admin.firestore();
    
    // 查询映射集合
    const mappingDoc = await db.collection('customerMapping').doc(paddleCustomerId).get();
    
    if (mappingDoc.exists) {
      return mappingDoc.data()?.firebaseUserId || null;
    }
    
    return null;
  } catch (error) {
    console.error(`查找Firebase用户ID失败:`, error);
    return null;
  }
}

/**
 * 从产品ID确定订阅计划类型
 */
function getPlanTypeFromProductId(productId) {
  // 根据实际的产品ID进行映射
  // 这里需要根据实际的Paddle产品ID进行配置
  if (typeof productId === 'string') {
    if (productId.includes('monthly')) {
      return SubscriptionPlan.MONTHLY;
    } else if (productId.includes('annual') || productId.includes('yearly')) {
      return SubscriptionPlan.ANNUAL;
    }
  }
  return null;
}

/**
 * 验证Paddle Webhook签名的函数
 */
function verifyPaddleSignature(req) {
  // 从请求中获取签名
  const signature = req.body.p_signature;
  if (!signature) {
    console.error('没有在webhook负载中找到签名');
    return false;
  }

  // 删除签名字段，因为它不是签名计算的一部分
  delete req.body.p_signature;

  // 按字母顺序对字段进行排序
  const serialized = Object.keys(req.body)
    .sort()
    .map(key => `${key}=${req.body[key]}`)
    .join('&');

  // 使用Paddle公钥验证签名
  try {
    const verifier = crypto.createVerify('sha1WithRSAEncryption');
    verifier.update(serialized);
    return verifier.verify(PADDLE_PUBLIC_KEY, signature, 'base64');
  } catch (error) {
    console.error('验证签名时出错:', error.message);
    return false;
  }
}

/**
 * 清理对象以适用于Firestore存储，将undefined值替换为null
 */
function cleanFirestoreData(obj) {
  // 如果不是对象或为null，直接返回
  if (obj === null || typeof obj !== 'object' || Array.isArray(obj)) {
    return obj;
  }
  
  // 创建一个干净的对象
  const cleanedObj = {};
  
  // 遍历原对象的所有属性
  for (const [key, value] of Object.entries(obj)) {
    if (value === undefined) {
      // 将undefined值替换为null
      cleanedObj[key] = null;
    } else if (value !== null && typeof value === 'object') {
      // 递归处理嵌套对象
      cleanedObj[key] = cleanFirestoreData(value);
    } else {
      // 保留其他值
      cleanedObj[key] = value;
    }
  }
  
  return cleanedObj;
}

/**
 * 更新用户的会员状态到Firestore
 */
async function updateUserMembership(userId, membershipState) {
  try {
    const db = admin.firestore();
    const userRef = db.collection('users').doc(userId);
    
    // 清理会员状态数据，确保没有undefined值
    const cleanedMembershipState = cleanFirestoreData(membershipState);
    
    // 更新用户文档中的会员信息 - 使用解构方式简化代码
    await userRef.set({
      membership: {
        ...cleanedMembershipState,
        updatedAt: Date.now()
      }
    }, { merge: true });
    
    // 更新专门的会员状态文档
    const membershipRef = userRef.collection('membership').doc('status');
    await membershipRef.set(cleanedMembershipState);
    
    console.log(`会员状态已更新，用户ID: ${userId}, 状态: ${cleanedMembershipState.status}`);
  } catch (error) {
    console.error(`更新用户会员状态失败，用户ID: ${userId}:`, error);
    throw error;
  }
}

/**
 * 获取当前用户的会员状态
 */
async function getCurrentMembershipState(userId) {
  try {
    const db = admin.firestore();
    
    // 先尝试从专门的会员状态文档读取
    const membershipDoc = await db.collection('users').doc(userId)
      .collection('membership').doc('status').get();
    
    if (membershipDoc.exists) {
      return membershipDoc.data();
    }
    
    // 如果没有找到，尝试从用户文档中读取
    const userDoc = await db.collection('users').doc(userId).get();
    if (userDoc.exists && userDoc.data().membership) {
      const membership = userDoc.data().membership;
      return {
        status: membership.status || MembershipStatus.FREE,
        plan: membership.plan || null,
        startedAt: membership.startedAt || null,
        expiresAt: membership.expiresAt || null,
        cancelAtPeriodEnd: membership.cancelAtPeriodEnd || false,
        lastVerifiedAt: Date.now(),
        subscriptionId: membership.subscriptionId || null,
        customerId: userId,
        updatedAt: Date.now()
      };
    }
    
    // 如果都没有找到，返回默认免费状态
    return {
      status: MembershipStatus.FREE,
      plan: null,
      startedAt: null,
      expiresAt: null,
      cancelAtPeriodEnd: false,
      lastVerifiedAt: Date.now(),
      subscriptionId: null,
      customerId: userId,
      updatedAt: Date.now()
    };
  } catch (error) {
    console.error(`获取用户会员状态失败，用户ID: ${userId}:`, error);
    // 出错时返回默认免费状态
    return {
      status: MembershipStatus.FREE,
      plan: null,
      startedAt: null,
      expiresAt: null,
      cancelAtPeriodEnd: false,
      lastVerifiedAt: Date.now(),
      subscriptionId: null,
      customerId: userId,
      updatedAt: Date.now()
    };
  }
}

// 处理订阅创建事件
async function handleSubscriptionCreated(payload) {
  // 新版API数据在data字段中
  const data = payload.data;
  if (!data) {
    console.error('在订阅创建webhook中未找到数据');
    return;
  }

  const customerId = data.customer_id;
  const subscriptionId = data.id;
  const status = data.status;
  const nextBillDate = data.next_billed_at;
  const items = data.items || [];
  
  // 查找产品信息
  let productId = null;
  if (items.length > 0 && items[0].price && items[0].price.product_id) {
    productId = items[0].price.product_id;
  }

  if (!customerId) {
    console.error('在订阅创建webhook中未找到customer_id');
    return;
  }

  try {
    // 提取Firebase用户ID（从passthrough或customData）
    let firebaseUserId = extractFirebaseUserId(payload);
    
    // 如果找不到Firebase用户ID，尝试从映射中查找
    if (!firebaseUserId) {
      firebaseUserId = await findFirebaseUserIdByPaddleCustomerId(customerId);
    }
    
    // 如果还是找不到，记录错误并使用Paddle用户ID
    const userId = firebaseUserId || customerId;
    
    // 如果找到了Firebase用户ID，创建/更新映射
    if (firebaseUserId) {
      await createUserIdMapping(customerId, firebaseUserId);
    } else {
      console.warn(`无法找到对应的Firebase用户ID，使用Paddle用户ID: ${customerId}`);
    }
    
    // 确定订阅计划类型
    const planType = getPlanTypeFromProductId(productId);
    
    // 确定会员状态
    const membershipStatus = status === 'active' || status === 'trialing' ? 
      MembershipStatus.PRO : MembershipStatus.FREE;
    
    // 计算到期日期
    const expiresAt = nextBillDate ? new Date(nextBillDate).getTime() : null;
    
    // 构建会员状态
    const membershipState = {
      status: membershipStatus,
      plan: planType,
      startedAt: Date.now(),
      expiresAt,
      cancelAtPeriodEnd: false,
      lastVerifiedAt: Date.now(),
      subscriptionId: subscriptionId,
      customerId: customerId,
      updatedAt: Date.now()
    };
    
    // 更新用户会员状态
    await updateUserMembership(userId, membershipState);
    
    // 更新用户基本信息
    await admin.firestore().collection('users').doc(userId).set(cleanFirestoreData({
      paddleCustomerId: customerId, // 添加Paddle客户ID到用户记录
      updatedAt: admin.firestore.FieldValue.serverTimestamp()
    }), { merge: true });
    
    console.log(`订阅已创建，用户ID: ${userId}, Paddle客户ID: ${customerId}, 订阅ID: ${subscriptionId}`);
  } catch (error) {
    console.error(`为 ${customerId} 创建订阅时出错: ${error.message}`);
  }
}

// 处理订阅已取消事件
async function handleSubscriptionCancelled(payload) {
  const data = payload.data;
  if (!data) {
    console.error('在订阅取消webhook中未找到数据');
    return;
  }

  const customerId = data.customer_id;
  const subscriptionId = data.id;

  if (!customerId) {
    console.error('在订阅取消webhook中未找到customer_id');
    return;
  }

  try {
    // 提取Firebase用户ID
    let firebaseUserId = extractFirebaseUserId(payload);
    
    // 如果找不到Firebase用户ID，尝试从映射中查找
    if (!firebaseUserId) {
      firebaseUserId = await findFirebaseUserIdByPaddleCustomerId(customerId);
    }
    
    // 如果还是找不到，记录错误并使用Paddle用户ID
    const userId = firebaseUserId || customerId;
    
    // 获取当前的会员状态
    const currentState = await getCurrentMembershipState(userId);
    
    // 确定结束日期（立即取消或周期结束时取消）
    const endDate = data.ends_at ? new Date(data.ends_at).getTime() : null;
    const now = Date.now();
    
    // 如果结束日期是当前或过去，立即将状态设为free
    // 否则标记为在周期结束后取消，但保持pro状态直到结束日期
    if (endDate && endDate <= now) {
      // 立即取消
      const updatedState = {
        ...currentState,
        status: MembershipStatus.FREE,
        cancelAtPeriodEnd: false,
        expiresAt: endDate || now,
        lastVerifiedAt: now,
        updatedAt: now
      };
      
      await updateUserMembership(userId, updatedState);
    } else {
      // 周期结束后取消
      const updatedState = {
        ...currentState,
        cancelAtPeriodEnd: true,
        expiresAt: endDate || currentState.expiresAt,
        lastVerifiedAt: now,
        updatedAt: now
      };
      
      await updateUserMembership(userId, updatedState);
    }
    
    console.log(`订阅已取消，用户ID: ${userId}, Paddle客户ID: ${customerId}, 订阅ID: ${subscriptionId}`);
  } catch (error) {
    console.error(`为 ${customerId} 取消订阅时出错: ${error.message}`);
  }
}

// 处理付款成功事件
async function handlePaymentSucceeded(payload) {
  const data = payload.data;
  if (!data) {
    console.error('在付款成功webhook中未找到数据');
    return;
  }

  const customerId = data.customer_id;
  const transactionId = data.transaction_id;
  const subscriptionId = data.subscription_id;
  const nextBillDate = data.next_payment?.date;

  if (!customerId) {
    console.error('在付款成功webhook中未找到customer_id');
    return;
  }

  try {
    // 提取Firebase用户ID
    let firebaseUserId = extractFirebaseUserId(payload);
    
    // 如果找不到Firebase用户ID，尝试从映射中查找
    if (!firebaseUserId) {
      firebaseUserId = await findFirebaseUserIdByPaddleCustomerId(customerId);
    }
    
    // 如果还是找不到，记录错误并使用Paddle用户ID
    const userId = firebaseUserId || customerId;
    
    // 如果找到了Firebase用户ID，创建/更新映射
    if (firebaseUserId) {
      await createUserIdMapping(customerId, firebaseUserId);
    } else {
      console.warn(`无法找到对应的Firebase用户ID，使用Paddle用户ID: ${customerId}`);
    }
    
    // 获取当前的会员状态
    const currentState = await getCurrentMembershipState(userId);
    
    // 计算新的到期日期
    const expiresAt = nextBillDate ? new Date(nextBillDate).getTime() : currentState.expiresAt;
    
    // 更新会员状态
    const updatedState = {
      ...currentState,
      status: MembershipStatus.PRO, // 支付成功，确保状态为pro
      expiresAt,
      lastVerifiedAt: Date.now(),
      subscriptionId: subscriptionId || currentState.subscriptionId,
      customerId: customerId,
      updatedAt: Date.now()
    };
    
    // 更新用户会员状态
    await updateUserMembership(userId, updatedState);
    
    // 提取价格信息
    let amount = null;
    let currency = data.currency_code || 'USD';
    
    if (data.items && data.items.length > 0 && data.items[0].price && data.items[0].price.unit_price) {
      amount = data.items[0].price.unit_price.amount;
    }

    // 记录支付历史
    await admin.firestore().collection('users').doc(userId)
      .collection('paymentHistory').add(cleanFirestoreData({
        subscriptionId: subscriptionId,
        transactionId: transactionId,
        amount: amount,
        currency: currency,
        paymentDate: new Date(payload.occurred_at).getTime(),
        nextBillDate: expiresAt,
        createdAt: admin.firestore.FieldValue.serverTimestamp()
      }));
    
    console.log(`付款已记录，用户ID: ${userId}, Paddle客户ID: ${customerId}, 交易ID: ${transactionId}, 订阅ID: ${subscriptionId || 'unknown'}`);
  } catch (error) {
    console.error(`为 ${customerId} 记录付款时出错: ${error.message}`);
  }
}

