    console.error(`为 ${customerId} 恢复订阅时出错: ${error.message}`);
  }
}

// 处理付款失败事件
async function handlePaymentFailed(payload) {
  const data = payload.data;
  if (!data) {
    console.error('在付款失败webhook中未找到数据');
    return;
  }

  const customerId = data.customer_id;
  const subscriptionId = data.subscription_id;

  if (!customerId) {
    console.error('在付款失败webhook中未找到customer_id');
    return;
  }

  try {
    // 提取Firebase用户ID
    let firebaseUserId = extractFirebaseUserId(payload);
    
    // 如果找不到Firebase用户ID，尝试从映射中查找
    if (!firebaseUserId) {
      firebaseUserId = await findFirebaseUserIdByPaddleCustomerId(customerId);
    }
    
    // 如果还是找不到，记录错误并使用Paddle用户ID
    const userId = firebaseUserId || customerId;
    
    // 注意：不要立即将用户降级为免费用户
    // 支付失败通常会有多次重试，此时应该记录失败状态但不改变会员状态
    // 如果多次失败后订阅被取消，会触发subscription_cancelled事件
    
    // 记录支付失败历史
    await admin.firestore().collection('users').doc(userId)
      .collection('paymentHistory').add(cleanFirestoreData({
        subscriptionId: subscriptionId,
        status: 'failed',
        failureReason: data.error_message || '未知错误',
        failureDate: new Date(payload.occurred_at).getTime(),
        createdAt: admin.firestore.FieldValue.serverTimestamp()
      }));
    
    // 将失败信息添加到用户文档，但不改变会员状态
    await admin.firestore().collection('users').doc(userId).set(cleanFirestoreData({
      paymentFailures: admin.firestore.FieldValue.increment(1),
      lastPaymentFailure: Date.now(),
      updatedAt: admin.firestore.FieldValue.serverTimestamp()
    }), { merge: true });
    
    console.log(`付款失败已记录，用户ID: ${userId}, Paddle客户ID: ${customerId}, 订阅ID: ${subscriptionId || 'unknown'}`);
  } catch (error) {
    console.error(`为 ${customerId} 记录付款失败时出错: ${error.message}`);
  }
}

// 处理交易完成事件
async function handleTransactionCompleted(payload) {
  try {
    const data = payload.data;
    if (!data || !data.subscription_id) {
      console.log('交易完成事件中没有订阅ID，跳过处理');
      return;
    }
    
    // 获取相关订阅的信息
    const subscriptionId = data.subscription_id;
    const customerId = data.customer_id;
    
    if (!customerId) {
      console.error('交易完成事件中缺少客户ID:', payload);
      return;
    }
    
    console.log(`处理交易完成事件，订阅ID: ${subscriptionId}, 客户ID: ${customerId}`);
    
    // 提取Firebase用户ID
    let firebaseUserId = extractFirebaseUserId(payload);
    
    // 如果找不到Firebase用户ID，尝试从映射中查找
    if (!firebaseUserId) {
      firebaseUserId = await findFirebaseUserIdByPaddleCustomerId(customerId);
    }
    
    // 如果还是找不到，记录错误并使用Paddle用户ID
    const userId = firebaseUserId || customerId;
    
    // 如果找到了Firebase用户ID，创建/更新映射
    if (firebaseUserId) {
      await createUserIdMapping(customerId, firebaseUserId);
    } else {
      console.warn(`无法找到对应的Firebase用户ID，使用Paddle用户ID: ${customerId}`);
    }
    
    // 查询订阅信息
    // 注意：实际实现可能需要调用Paddle API获取订阅详情
    // 这里简化处理，假设订阅是有效的
    const membershipState = cleanFirestoreData({
      status: MembershipStatus.PRO,
      plan: data.items && data.items[0] && data.items[0].price && data.items[0].price.billing_cycle 
            ? (data.items[0].price.billing_cycle.interval === 'month' ? 'monthly' : 'annual')
            : null,
      startedAt: Date.now(),
      expiresAt: data.next_payment ? new Date(data.next_payment.date).getTime() : null,
      cancelAtPeriodEnd: false,
      lastVerifiedAt: Date.now(),
      subscriptionId: subscriptionId,
      customerId: customerId,
      updatedAt: Date.now()
    });
    
    // 更新用户会员状态
    await updateUserMembership(userId, membershipState);
    
    console.log(`交易完成，已更新会员状态，用户ID: ${userId}, Paddle客户ID: ${customerId}, 订阅ID: ${subscriptionId}`);
  } catch (error) {
    console.error('处理交易完成事件失败:', error);
  }
}

// 注册HTTP函数
functions.http('paddle-webhooks', (req, res) => {
  // 只处理POST请求，其他请求类型直接返回欢迎信息
  if (req.method !== 'POST') {
    res.status(200).send('Hello from Paddle Webhook Handler!');
    return;
  }
  
  // 确保请求体存在
  if (!req.body) {
    console.log('接收到空请求体');
    res.status(200).send('Received but empty body');
    return;
  }
  
  // 验证是否为Paddle Webhook数据
  if (!req.body.event_type && !req.body.alert_name) {
    console.log('请求体不包含event_type或alert_name，可能不是有效的Paddle webhook:', JSON.stringify(req.body).substring(0, 200) + '...');
    res.status(200).send('Received but not a valid Paddle webhook');
    return;
  }
  
  // 获取事件类型（支持新旧API）
  const eventType = req.body.event_type || req.body.alert_name;
  console.log('处理Paddle webhook事件:', eventType);
  
  // 验证请求签名（生产环境中启用）
  // if (!verifyPaddleSignature(req)) {
  //   console.error('Invalid webhook signature');
  //   return res.status(401).send('Invalid signature');
  // }
  
  try {
    // 根据事件类型处理不同的webhook
    switch (eventType) {
      // 新版API事件
      case 'subscription.created':
        handleSubscriptionCreated(req.body);
        break;
      case 'subscription.updated':
        handleSubscriptionUpdated(req.body);
        break;
      case 'subscription.cancelled':
        handleSubscriptionCancelled(req.body);
        break;
      case 'subscription.paused':
        handleSubscriptionPaused(req.body);
        break;
      case 'subscription.resumed':
        handleSubscriptionResumed(req.body);
        break;
      case 'subscription.payment.succeeded':
        handlePaymentSucceeded(req.body);
        break;
      case 'subscription.payment.failed':
        handlePaymentFailed(req.body);
        break;
      case 'subscription.activated':
        handleSubscriptionUpdated(req.body);
        break;
      case 'transaction.completed':
        handleTransactionCompleted(req.body);
        break;
      case 'transaction.created':
      case 'transaction.updated':
      case 'transaction.ready':
      case 'transaction.paid':
        // 记录但不特别处理这些事件
        console.log(`记录交易相关事件: ${eventType}，等待transaction.completed事件`);
        break;
      
      // 旧版API事件
      case 'subscription_created':
        handleSubscriptionCreated(req.body);
        break;
      case 'subscription_updated':
        handleSubscriptionUpdated(req.body);
        break;
      case 'subscription_cancelled':
        handleSubscriptionCancelled(req.body);
        break;
      case 'subscription_payment_succeeded':
        handlePaymentSucceeded(req.body);
        break;
      case 'subscription_payment_failed':
        handlePaymentFailed(req.body);
        break;
      
      // 可以添加更多事件处理
      default:
        console.log(`未处理的webhook事件类型: ${eventType}`);
    }
    
    // 返回成功响应
    res.status(200).send('Webhook processed successfully');
  } catch (error) {
    // 即使出错也返回200，避免Paddle重试
    console.error(`处理webhook时出错: ${error.message}`);
    res.status(200).send('Error processing webhook, but acknowledged');
  }
});

