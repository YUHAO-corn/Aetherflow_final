    // 确定是否将在周期结束后取消
    const cancelAtPeriodEnd = data.paused_at ? false : 
                             Boolean(status === 'active' && data.cancel_at_end_of_billing_period);
    
    // 构建更新后的会员状态
    const updatedState = {
      ...currentState,
      status: membershipStatus,
      plan: planType,
      expiresAt,
      cancelAtPeriodEnd,
      lastVerifiedAt: Date.now(),
      subscriptionId: subscriptionId,
      customerId: customerId,
      updatedAt: Date.now()
