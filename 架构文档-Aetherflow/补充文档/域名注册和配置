## 第五步：注册Paddle账户

1. **创建Paddle账户**：
   - 访问[Paddle注册页面](https://vendors.paddle.com/signup)
   - 填写必要信息，包括公司/个人信息
   - 完成身份验证步骤(可能需要提供身份证明文件)

2. **配置产品**：
   - 登录Paddle控制台
   - 创建两个订阅产品：
     - 月度计划($3.99/月)
     - 年度计划($39.99/年)
   - 记录产品ID，稍后在代码中使用

3. **配置webhook**：
   - 在Paddle控制台找到"Developer Tools" > "Webhook"
   - 添加webhook URL：`https://api.aetherflow-app.com/webhook/paddle`或使用云函数URL
   - 选择需要接收的事件类型(subscription_created, subscription_updated等)

## 第六步：配置Firebase(或其他后端)接收webhook

1. **创建Firebase账户**：
   - 访问[Firebase控制台](https://console.firebase.google.com/)
   - 创建新项目"aetherflow"

2. **设置Firebase Functions**：
   - 安装Firebase CLI：`npm install -g firebase-tools`
   - 初始化项目：`firebase init functions`
   - 创建webhook处理函数

3. **示例Firebase Function代码**：
```javascript
const functions = require('firebase-functions');
const admin = require('firebase-admin');
admin.initializeApp();

exports.paddleWebhook = functions.https.onRequest(async (req, res) => {
  // 验证请求来源
  // 处理各种订阅事件
  // 更新数据库中的会员状态
  
  console.log('接收到Paddle Webhook:', req.body);
  
  // 根据事件类型处理
  const { alert_name } = req.body;
  
  switch(alert_name) {
    case 'subscription_created':
      await handleSubscriptionCreated(req.body);
      break;
    case 'subscription_updated':
      await handleSubscriptionUpdated(req.body);
      break;
    // 其他事件处理...
  }
  
  // 返回成功
  res.status(200).send('Webhook processed');
});

async function handleSubscriptionCreated(data) {
  // 实现订阅创建逻辑
  const { subscription_id, user_id, status } = data;
  
  // 更新用户会员状态
  await admin.firestore().collection('memberships').doc(user_id).set({
    subscriptionId: subscription_id,
    status: 'pro',
    plan: data.plan_type === 'month' ? 'monthly' : 'annual',
    startedAt: admin.firestore.FieldValue.serverTimestamp(),
    expiresAt: new Date(data.next_bill_date),
  });
}
```

4. **部署Firebase Functions**：
   - `firebase deploy --only functions`
   - 记录函数URL，配置到Paddle webhook设置

## 第七步：集成Paddle到官网支付页面

1. **添加Paddle脚本**：
在您网站的HTML中添加以下代码：

```html
<script src="https://cdn.paddle.com/paddle/paddle.js"></script>
<script type="text/javascript">
    // 初始化Paddle
    Paddle.Setup({ 
        vendor: 12345,  // 替换为您的Paddle Vendor ID
        eventCallback: function(data) {
            console.log(data);
        }
    });
    
    // 月度计划按钮
    document.getElementById('monthly-plan').addEventListener('click', function() {
        Paddle.Checkout.open({
            product: 12345,  // 替换为月度计划产品ID
            email: getParameterByName('email'),  // 从URL参数获取邮箱
            successCallback: handleSuccess
        });
    });
    
    // 年度计划按钮
    document.getElementById('annual-plan').addEventListener('click', function() {
        Paddle.Checkout.open({
            product: 67890,  // 替换为年度计划产品ID
            email: getParameterByName('email'),
            successCallback: handleSuccess
        });
    });
    
    // 处理成功回调
    function handleSuccess(data) {
        // 重定向到成功页面
        window.location.href = '/payment/success?order_id=' + data.checkout.order_id;
    }
    
    // 从URL获取参数函数
    function getParameterByName(name) {
        const url = window.location.href;
        name = name.replace(/[\[\]]/g, '\\$&');
        const regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)');
        const results = regex.exec(url);
        if (!results) return null;
        if (!results[2]) return '';
        return decodeURIComponent(results[2].replace(/\+/g, ' '));
    }
</script>
```

