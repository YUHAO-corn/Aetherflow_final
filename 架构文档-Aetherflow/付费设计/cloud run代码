const functions = require('@google-cloud/functions-framework');
const admin = require('firebase-admin');
const express = require('express');
const cors = require('cors');
const crypto = require('crypto');

// 初始化Firebase Admin SDK
admin.initializeApp();

// Paddle API密钥（用于验证webhook签名）
const PADDLE_PUBLIC_KEY = process.env.PADDLE_PUBLIC_KEY || '';

// 创建Express应用
const app = express();

// 启用CORS
app.use(cors({ origin: true }));

// 验证Paddle Webhook签名的函数
function verifyPaddleSignature(req) {
  // 从请求中获取签名
  const signature = req.body.p_signature;
  if (!signature) {
    console.error('No signature found in webhook payload');
    return false;
  }

  // 删除签名字段，因为它不是签名计算的一部分
  delete req.body.p_signature;

  // 按字母顺序对字段进行排序
  const serialized = Object.keys(req.body)
    .sort()
    .map(key => `${key}=${req.body[key]}`)
    .join('&');

  // 使用Paddle公钥验证签名
  try {
    const verifier = crypto.createVerify('sha1WithRSAEncryption');
    verifier.update(serialized);
    return verifier.verify(PADDLE_PUBLIC_KEY, signature, 'base64');
  } catch (error) {
    console.error('Error verifying signature:', error.message);
    return false;
  }
}

// 处理订阅创建事件
async function handleSubscriptionCreated(payload) {
  // 新版API数据在data字段中
  const data = payload.data;
  if (!data) {
    console.error('No data found in subscription created webhook');
    return;
  }

  const customerId = data.customer_id;
  const subscriptionId = data.id;
  const status = data.status;
  const nextBillDate = data.next_billed_at;

  if (!customerId) {
    console.error('No customer_id found in subscription created webhook');
    return;
  }

  try {
    // 使用set而不是update，确保即使文档不存在也能正常工作
    await admin.firestore().collection('users').doc(customerId).set({
      subscriptionId: subscriptionId,
      subscriptionStatus: status,
      membershipTier: 'premium',
      membershipExpiry: new Date(nextBillDate).getTime(),
      updatedAt: admin.firestore.FieldValue.serverTimestamp()
    }, { merge: true });
    
    console.log(`Subscription created for customer ${customerId}, subscription ID: ${subscriptionId}`);
  } catch (error) {
    console.error(`Error creating subscription for ${customerId}: ${error.message}`);
  }
}

