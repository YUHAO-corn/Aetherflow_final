// 处理付款成功事件
async function handlePaymentSucceeded(payload) {
  const data = payload.data;
  if (!data) {
    console.error('No data found in payment succeeded webhook');
    return;
  }

  const customerId = data.customer_id;
  const transactionId = data.transaction_id;

  if (!customerId) {
    console.error('No customer_id found in payment succeeded webhook');
    return;
  }

  try {
    // 提取价格信息
    let amount = null;
    let currency = data.currency_code || 'USD';
    
    if (data.items && data.items.length > 0 && data.items[0].price && data.items[0].price.unit_price) {
      amount = data.items[0].price.unit_price.amount;
    }

    // 记录支付历史
    await admin.firestore().collection('users').doc(customerId)
      .collection('paymentHistory').add({
        subscriptionId: data.id,
        transactionId: transactionId,
        amount: amount,
        currency: currency,
        paymentDate: new Date(payload.occurred_at).getTime(),
        createdAt: admin.firestore.FieldValue.serverTimestamp()
      });
    
    // 更新用户的付款状态
    await admin.firestore().collection('users').doc(customerId).set({
      lastPaymentDate: new Date(payload.occurred_at).getTime(),
      paymentStatus: 'paid',
      updatedAt: admin.firestore.FieldValue.serverTimestamp()
    }, { merge: true });
    
    console.log(`Payment recorded for customer ${customerId}, transaction ID: ${transactionId}`);
  } catch (error) {
    console.error(`Error recording payment for ${customerId}: ${error.message}`);
  }
}

